# 필수
OPENAI_API_KEY=sk-...

# 선택: OpenAI 호환 엔드포인트 (프록시/타 제공자 사용 시)
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1

# 선택: 모델 / 검색 파라미터 (기본값은 rag/config.py 참고)
# CHAT_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=5
# SIMILARITY_THRESHOLD=0.3
# RETRIEVAL_MODE=dense        # dense | hybrid
# BM25_TOKENIZER=bigram       # bigram | kiwi (hybrid 일 때)
# PROMPT_MODE=baseline        # baseline | evidence_first

# 선택: Eval
# JUDGE_MODEL=gpt-4.1
# SEED=42
